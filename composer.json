{
    "name": "laravel-guard/laravel-guard",
    "description": "Laravel-native security and multi-tenancy analysis for development and CI.",
    "keywords": ["laravel", "security", "multi-tenancy", "static-analysis", "ci"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "nikic/php-parser": "5.*"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {"psr-4": {"LaravelGuard\\": "src/"}},
    "autoload-dev": {"psr-4": {"LaravelGuard\\Tests\\": "tests/"}},
    "extra": {
        "laravel": {
            "providers": ["LaravelGuard\\LaravelGuardServiceProvider"],
            "aliases": {"LaravelGuard": "LaravelGuard\\Facades\\LaravelGuard"}
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
