{
    "name": "laravel-guard/laravel-guard",
    "description": "Laravel-native security and multi-tenancy analysis for development and CI.",
    "keywords": ["laravel", "security", "multi-tenancy", "static-analysis", "ci"],
    "homepage": "https://github.com/uditrawat03/laravel-guard",
    "support": {
        "issues": "https://github.com/uditrawat03/laravel-guard/issues",
        "source": "https://github.com/uditrawat03/laravel-guard"
    },
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "nikic/php-parser": "5.*"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "suggest": {
        "barryvdh/laravel-debugbar": "Publishes an opt-in scan summary to Debugbar.",
        "infection/infection": "Runs the optional mutation testing configuration.",
        "laravel/telescope": "Publishes an opt-in scan summary event for Telescope.",
        "phpstan/phpstan": "Enables the tenant-model PHPStan rule.",
        "spatie/laravel-multitenancy": "Enables the Spatie tenant resolver adapter.",
        "spatie/laravel-permission": "Enables recognition of Spatie authorization middleware.",
        "stancl/tenancy": "Enables the stancl tenant resolver adapter."
    },
    "autoload": {"psr-4": {"LaravelGuard\\": "src/"}},
    "autoload-dev": {"psr-4": {"LaravelGuard\\Tests\\": "tests/"}},
    "extra": {
        "laravel": {
            "providers": ["LaravelGuard\\LaravelGuardServiceProvider"],
            "aliases": {"LaravelGuard": "LaravelGuard\\Facades\\LaravelGuard"}
        },
        "phpstan": {
            "includes": ["extension.neon"]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "archive": {
        "exclude": [
            "/hospital-demo",
            "/vendor",
            "/.github",
            "/composer.lock",
            "/.phpunit.result.cache",
            "/tests",
            "/phpunit.xml",
            "/infection.json5",
            "/laravel-guard-implementation-blueprint.md"
        ]
    },
    "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": true}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
